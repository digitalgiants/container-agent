# Copy to ~/.config/container-agent/config.yaml during install (install.sh does this).

# Must match compose/.env CONTAINER_AGENT_DATA_DIR (install.sh keeps them in sync).
data_dir: ~/.local/share/container-agent

automation_mode: human_in_loop  # human_in_loop | full_auto
poll_interval_minutes: 5
max_restarts_per_hour: 5
log_tail_lines: 80
graceful_retries_before_force: 2

# Multi-service stacks: ordered compose up (dependencies first, e.g. postgres → api).
stack_recovery_enabled: true
stack_recovery_wait_seconds: 30

# Recursively finds compose.yaml / docker-compose.yml under each path (e.g. every git repo).
compose_search_paths:
  - /home/digilabs

protected_volume_globs:
  - "**/postgres/**"
  - "**/mysql/**"
  - "**/mariadb/**"
  - "**/*backup*"
  - "**/*.db"
  - "**/*.sqlite*"

lock_file_patterns:
  - "*.lock"
  - "*.pid"
  - "*-wal"
  - "*-shm"

log_error_patterns:
  - "could not connect to server"
  - "connection refused"
  - "database is locked"
  - "Resource temporarily unavailable"
  - "file is locked"
  - "Permission denied"
  - "OOM"
  - "out of memory"
  - "oauth"
  - "token expired"
  - "sync failed"
  - "authentication failed"

disk_warn_percent_free: 15

web_ui_url: http://127.0.0.1:8787

# Local LLM (Ollama container from compose/docker-compose.yml).
ollama_url: http://127.0.0.1:11434
ollama_model: qwen2.5:7b-instruct
ollama_timeout_seconds: 180

# Optional extra Caddyfiles for service health labels (also scans /etc/caddy and Caddy containers).
# caddyfile_paths:
#   - /etc/caddy/Caddyfile
